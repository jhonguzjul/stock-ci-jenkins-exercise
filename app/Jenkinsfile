// Pipeline declarativo. Vive en app/ (Script Path del job: app/Jenkinsfile).
pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        IMAGEN = "inventario:${env.BUILD_NUMBER}"
        HUMO   = "inventario-humo-${env.BUILD_NUMBER}"
    }

    stages {
        stage('Pruebas unitarias') {
            // Contenedor efímero: Jenkins lo crea solo para esta etapa y lo elimina al terminar.
            agent {
                docker {
                    image 'python:3.12-slim'
                    reuseNode true
                }
            }
            environment {
                HOME = "${env.WORKSPACE}"
                PIP_NO_CACHE_DIR = '1'
            }
            steps {
                dir('app') {
                    sh '''
                        python -m venv .venv
                        . .venv/bin/activate
                        pip install -q -r requirements-dev.txt
                        pytest -v --junitxml=reports/junit.xml
                    '''
                }
            }
            post {
                always {
                    junit 'app/reports/junit.xml'
                }
            }
        }

        stage('Construir imagen') {
            steps {
                sh 'docker build -t "$IMAGEN" app'
            }
        }

        stage('Prueba de humo') {
            steps {
                sh '''
                    docker run -d --name "$HUMO" "$IMAGEN"
                    sleep 3
                    docker exec "$HUMO" python -c "import urllib.request; print(urllib.request.urlopen('http://localhost:8000/health').read().decode())"
                '''
            }
            post {
                always {
                    sh 'docker rm -f "$HUMO" || true'
                }
            }
        }
    }
}
